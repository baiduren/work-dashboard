# 本地开发数据库（prisma/dev.db，已被 .gitignore 忽略）。
# Docker 部署时无需此文件：容器内由环境变量覆盖为挂载卷路径，
# 见 docker-compose.yml 与 docs/adr/0002-docker-deployment.md。
DATABASE_URL="file:./dev.db"

# 登录认证（docs/adr/0004-authentication.md）：单用户账号 + 密码，凭据只存在环境变量。
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me-please"
# 会话签名密钥：至少 32 个字符的随机串，泄露或更换后所有会话立即失效。
# 生成示例：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SESSION_SECRET="replace-with-a-random-secret-at-least-32-chars-long"
